      </attenuation>
    </light>
    <light type="point" name="fill_light_5">
      <cast_shadows>false</cast_shadows>
      <pose>-28.424 -4.144 15 0 0 0</pose>
      <diffuse>0.85 0.85 0.78 1</diffuse>
      <specular>0 0 0 1</specular>
      <attenuation>
        <range>90</range>
        <constant>0.4</constant>
        <linear>0.015</linear>
        <quadratic>0.0008</quadratic>
      </attenuation>
    </light>
    <light type="point" name="fill_light_6">
      <cast_shadows>false</cast_shadows>
      <pose>-28.424 4.356 15 0 0 0</pose>
      <diffuse>0.85 0.85 0.78 1</diffuse>
      <specular>0 0 0 1</specular>
      <attenuation>
        <range>90</range>
        <constant>0.4</constant>
        <linear>0.015</linear>
        <quadratic>0.0008</quadratic>
      </attenuation>
    </light>
      </link>
    </model> <!-- end lighting -->
    <!--
      WARNING for below: Height maps and planes ignore the rotation component of their pose! You just have to resize them if you want to rotate them!
    -->
    <model name='ground'>
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <model name='ground_plane'>
      <static>true</static>
      <pose>-2.286 0.000 0 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>120 80</size></plane></geometry>
          <surface><friction><ode/></friction><bounce/><contact/></surface>
        </collision>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia><ixx>1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1</iyy><iyz>0</iyz><izz>1</izz></inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <model name='hill'>
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <pose>-12.9456 3.644 0 0 0 0</pose>
          <geometry><mesh><uri>meshes/hill_collision_box.obj</uri><scale>1 1 1</scale></mesh></geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <heightmap>
              <uri>materials/textures/hill_heightmap.png</uri>
              <size>18.0 12.0 0.75</size>
              <pos>-12.9456 3.644 0.001</pos>
              <texture>
                <diffuse>materials/textures/sparse_ground_foliage_texture.jpg</diffuse>
                <normal>materials/textures/sparse_ground_foliage_reflection_map.png</normal>
                <size>2.0</size>
              </texture>
            </heightmap>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <pbr>
              <metal>
                <roughness>1.0</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model> 
    <model name='ground_grass_visual'>
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <heightmap>
              <uri>materials/textures/ground_flat_heightmap.png</uri>
              <size>120 80 0.001</size>
              <pos>-2.2860 0.0000 0.0005</pos>
              <texture>
                <diffuse>materials/textures/sparse_ground_foliage_texture.jpg</diffuse>
                <normal>materials/textures/sparse_ground_foliage_reflection_map.png</normal>
                <size>2.0000</size>
              </texture>
            </heightmap>
          </geometry> 
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <pbr>
              <metal>
                <roughness>1.0</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>
    </model> <!-- end ground -->
