<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='homebrew_base'>
    <pose>0 0 .162 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="base_link">
      <self_collide>false</self_collide>
      <gravity>true</gravity>
      <velocity_decay/>

      <!-- Taken from Mingyuan Gao's SOLIDWORKS model--->
      <inertial>
        <mass>2.27304650076778</mass>
        <inertia>
          <ixx>0.0042284876572578</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00572258822097371</iyy>
          <iyz>0</iyz>
          <izz>0.00831273635864134</izz>
        </inertia>
      </inertial>

      <visual name="base_link_visual">
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.2 1</diffuse>
          <specular>0 0 0 0</specular>
          <emissive>0 0 0 1</emissive>
        </material>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://homebrew_base/meshes/base_link.stl</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- Collision: a small central pod box + FOUR SPHERICAL FEET.
           Everything that can touch the ground is either box-on-flat-plane
           (the pod, on the flight-cage floor) or a sphere (the feet, which
           are what touch on the hill).
           Designed to minimize any oddities with collision.
           -->
      <collision name="base_link_collision_pod">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <box>
            <size>0.22 0.22 0.12</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <collision name="foot_fl_collision">
        <pose>0.09 0.18 -0.1325 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <collision name="foot_fr_collision">
        <pose>0.09 -0.18 -0.1325 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <collision name="foot_bl_collision">
        <pose>-0.09 0.18 -0.1325 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <collision name="foot_br_collision">
        <pose>-0.09 -0.18 -0.1325 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>

      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <!-- Noise modeled after BMP390 -->
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <!-- 3mgauss RMS: NOTE: noise is in tesla but sensor reports data in gauss -->
          <!-- Noise modeled after IIS2MDC (from the x500 model)-->
          <x>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <!-- Noise modeled after IIM42653 (from the x500 model)-->
            <!-- 0.05 deg/s converted to rad/s -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <!-- Noise modeled after IIM42653 (from the x500 model) -->
            <!-- X & Y axis: 0.65 mg-rms converted to m/ss -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </y>
            <!-- Z axis: 0.70 mg-rms converted to m/ss-->
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00686</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <!-- RTK-level noise, as a diagnostic test for the GPS Horizontal Pos
             Drift preflight failure (2026-09-25): if this doesn't change
             pass/fail behavior, the drift isn't coming from GPS measurement
             noise/units, and is a real sustained position-derivative
             somewhere upstream (physics settling, lever-arm/attitude
             coupling, or a Gazebo NavSat timing bug), not this sensor's
             noise model. horizontal stddev is in DEGREES not meters (see
             NavSatSensor.cc), converted via this world's origin latitude
             (autonomy_park.sdf: 29.628147 deg N, ~103784 m/deg average of
             lat/lon scale factors there). Set every stddev to 0 to go back
             to noiseless. Do NOT comment this block out: XML comments don't
             nest, and doing so breaks the whole file's parsing. -->
        <navsat>
          <position_sensing>
            <horizontal>
              <!-- 2cm 1-sigma horizontal (RTK-level): 0.02 / 103784 m/deg -->
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>1.927e-07</stddev>
              </noise>
            </horizontal>
            <vertical>
              <!-- 3cm 1-sigma vertical (RTK vertical is typically somewhat
                   worse than horizontal) -->
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.03</stddev>
              </noise>
            </vertical>
          </position_sensing>
          <velocity_sensing>
            <horizontal>
              <!-- 2cm/s 1-sigma horizontal velocity (RTK-level Doppler) -->
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.02</stddev>
              </noise>
            </horizontal>
            <vertical>
              <!-- 3cm/s 1-sigma vertical velocity -->
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.03</stddev>
              </noise>
            </vertical>
          </velocity_sensing>
        </navsat>
      </sensor>

    </link>
    <link name="rotor_0">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <pose>0.2418 -0.2446 0.076024 0 0 0</pose><!--motor poses are fine-->
      <inertial>
        <!-- Mass/inertia from T-Motor U5 KV400 (Homebrew's motors) datasheet (156g, Φ42.5x37.5mm), inertia estimated as a solid cylinder -->
        <pose>0 0 0.006 0 0 0</pose>
        <mass>0.156</mass>
        <inertia>
          <ixx>0.00003589</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00003589</iyy>
          <iyz>0</iyz>
          <izz>0.00003522</izz>
        </inertia>
      </inertial>
      <!-- Own CAD: this mesh is the combined motor+prop assembly, not motor-only -->
      <visual name="rotor_0_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://homebrew_base/meshes/motor_ccw.stl</uri>
          </mesh>
        </geometry>
      </visual>
      <!-- Thin disc, not the full motor+prop box. This link genuinely spins
           (MulticopterMotorModel drives the joint), so a 3-D collision
           volume here is a spinning collider that pumps energy into any
           contact it clips on a tilted takeoff/landing - the x500 uses a
           ~1 mm plate for exactly this reason. Radius = prop half-span from
           motor_ccw.stl (0.386 / 2). <ode> contact params dropped (ignored
           by dartsim + bullet, as above). -->
      <collision name="rotor_0_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.193</radius>
            <length>0.004</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <link name="rotor_1">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <pose>-0.2418 0.2446 0.076024 0 0 0</pose>
      <inertial>
        <!-- Mass/inertia from T-Motor U5 KV400 datasheet (156g, Φ42.5x37.5mm), inertia estimated as a solid cylinder -->
        <pose>0 0 0.006 0 0 0</pose>
        <mass>0.156</mass>
        <inertia>
          <ixx>0.00003589</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00003589</iyy>
          <iyz>0</iyz>
          <izz>0.00003522</izz>
        </inertia>
      </inertial>
      <!-- Own CAD: this mesh is the combined motor+prop assembly, not motor-only -->
      <visual name="rotor_1_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://homebrew_base/meshes/motor_ccw.stl</uri>
          </mesh>
        </geometry>
      </visual>
      <!-- Thin disc - see rotor_0_collision. Radius from motor_ccw.stl. -->
      <collision name="rotor_1_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.193</radius>
            <length>0.004</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <link name="rotor_2">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <pose>0.2418 0.2446 0.0760238662373196 0 0 0</pose>
      <inertial>
        <!-- Mass/inertia from T-Motor U5 KV400 datasheet (156g, Φ42.5x37.5mm), inertia estimated as a solid cylinder -->
        <pose>0 0 0.006 0 0 0</pose>
        <mass>0.156</mass>
        <inertia>
          <ixx>0.00003589</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00003589</iyy>
          <iyz>0</iyz>
          <izz>0.00003522</izz>
        </inertia>
      </inertial>
      <!-- Own CAD: this mesh is the combined motor+prop assembly, not motor-only -->
      <visual name="rotor_2_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://homebrew_base/meshes/motor_cw.stl</uri>
          </mesh>
        </geometry>
      </visual>
      <!-- Thin disc - see rotor_0_collision. Radius = prop half-span from
           motor_cw.stl (0.3646 / 2). -->
      <collision name="rotor_2_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.182</radius>
            <length>0.004</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <link name="rotor_3">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <pose>-0.2418 -0.2446 0.0760238662373188 0 0 0</pose>
      <inertial>
        <!-- Mass/inertia from T-Motor U5 KV400 datasheet (156g, Φ42.5x37.5mm), inertia estimated as a solid cylinder -->
        <pose>0 0 0.006 0 0 0</pose>
        <mass>0.156</mass>
        <inertia>
          <ixx>0.00003589</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00003589</iyy>
          <iyz>0</iyz>
          <izz>0.00003522</izz>
        </inertia>
      </inertial>
      <!-- Own CAD: this mesh is the combined motor+prop assembly, not motor-only -->
      <visual name="rotor_3_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://homebrew_base/meshes/motor_cw.stl</uri>
          </mesh>
        </geometry>
      </visual>
      <!-- Thin disc - see rotor_0_collision. Radius from motor_cw.stl. -->
      <collision name="rotor_3_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.182</radius>
            <length>0.004</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
