<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='homebrew_base'>
    <pose>0 0 .162 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="base_link">
      <self_collide>false</self_collide>
      <gravity>true</gravity>
      <velocity_decay/>

      <inertial>
        <mass>2.27304650076778</mass>
        <inertia>
          <ixx>0.0042284876572578</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00572258822097371</iyy>
          <iyz>0</iyz>
          <izz>0.00831273635864134</izz>
        </inertia>
      </inertial>

      <visual name="base_link_visual">
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.2 1</diffuse>
          <specular>0 0 0 0</specular>
          <emissive>0 0 0 1</emissive>
        </material>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://homebrew_base/meshes/base_link.stl</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- Collision: a small central pod box + FOUR SPHERICAL FEET.
           Everything that can touch the ground is either box-on-flat-plane
           (the pod, on the flight-cage floor) or a sphere (the feet, which
           are what touch on the hill).

           Why spheres for the feet, not flat skid bars:
           The hill is a Bullet heightfield (confirmed in the gz server log:
           "DART Bullet heightfield ...") triangulated at ~5-7 cm/pixel,
           local slopes up to ~16 deg. A thin flat box spanning several of
           those triangles on a slope hits the classic internal-edge
           problem - Bullet hands back contacts with the wrong triangle's
           normal, some pointing INTO the surface. The skid then works its
           way in and wedges ("forks into the ground"), and it does not
           come back out: this stack (gz-physics 7.8 dartsim plugin,
           DART 6.13) does NOT read <surface><contact><ode> min_depth or
           max_vel - checked the plugin binaries - so DART's own contact
           constraint governs penetration recovery, and its default is
           weak: observed behavior is a deeply-penetrated body easing out
           over many seconds ("stuck on takeoff / slowly rises / then
           catapults when it finally pops free"). PX4's land detector flaps
           takeoff<->landed the whole time (see px4 log).
           x500 gets away with flat skid bars only because its geometry
           barely penetrates: ~20 cm of body clearance, tiny skid tips, an
           angled-leg truss. A sphere vs a triangle mesh has no edges to
           catch - the contact normal is always (sphere_center - surface),
           well-defined regardless of triangulation - so penetration stays
           shallow and DART's weak recovery is enough.

           Geometry from base_link.stl vertex extents:
             pod  (z ~ 0)     : dense body ~0.20 x 0.20 -> 0.22 box,
                                raised to z +0.02 so its underside (z -0.04)
                                clears a 16 deg slope with the feet planted.
             feet (z ~ -0.16) : mesh skid pair, y = +/-0.18, x = +/-0.09,
                                mesh underside z = -0.1625. Sphere r 0.03,
                                centers at z -0.1325 -> undersides at -0.1625.
           Model <pose> z is 0.162, so foot undersides sit at world z = 0 at
           rest (flush, no spawn interpenetration).
           <surface><contact><ode> kept only to mirror x500_base; it is
           inert here (see above). Friction = ode defaults (mu 1). -->
      <collision name="base_link_collision_pod">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <box>
            <size>0.22 0.22 0.12</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <collision name="foot_fl_collision">
        <pose>0.09 0.18 -0.1325 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <collision name="foot_fr_collision">
        <pose>0.09 -0.18 -0.1325 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <collision name="foot_bl_collision">
        <pose>-0.09 0.18 -0.1325 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <collision name="foot_br_collision">
        <pose>-0.09 -0.18 -0.1325 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>

      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <!-- Noise modeled after BMP390 -->
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <!-- 3mgauss RMS: NOTE: noise is in tesla but sensor reports data in gauss -->
          <!-- Noise modeled after IIS2MDC -->
          <x>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <!-- Noise modeled after IIM42653 -->
            <!-- 0.05 deg/s converted to rad/s -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <!-- Noise modeled after IIM42653 -->
            <!-- X & Y axis: 0.65 mg-rms converted to m/ss -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </y>
            <!-- Z axis: 0.70 mg-rms converted to m/ss-->
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00686</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>

    </link>
    <link name="rotor_0">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <pose>0.2418 -0.2446 0.076024 0 0 0</pose><!--motor poses are fine-->
      <inertial>
        <!-- Mass/inertia from T-Motor U5 KV400 datasheet (156g, Φ42.5x37.5mm), inertia estimated as a solid cylinder -->
        <pose>0 0 0.006 0 0 0</pose>
        <mass>0.156</mass>
        <inertia>
          <ixx>0.00003589</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00003589</iyy>
          <iyz>0</iyz>
          <izz>0.00003522</izz>
        </inertia>
      </inertial>
      <!-- Own CAD: this mesh is the combined motor+prop assembly, not motor-only -->
      <visual name="rotor_0_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://homebrew_base/meshes/motor_ccw.stl</uri>
          </mesh>
        </geometry>
      </visual>
      <!-- Thin disc, not the full motor+prop box. This link genuinely spins
           (MulticopterMotorModel drives the joint), so a 3-D collision
           volume here is a spinning collider that pumps energy into any
           contact it clips on a tilted takeoff/landing - the x500 uses a
           ~1 mm plate for exactly this reason. Radius = prop half-span from
           motor_ccw.stl (0.386 / 2). <ode> contact params dropped (ignored
           by dartsim + bullet, as above). -->
      <collision name="rotor_0_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.193</radius>
            <length>0.004</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

