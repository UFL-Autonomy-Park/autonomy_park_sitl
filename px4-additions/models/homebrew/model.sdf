    -->

    <!-- ZED 2 stand-in: no ZED 2 gz model exists yet, reusing OakD-Lite's RGB + depth_camera sensors (x500_depth's pattern/pose) -->
    <include merge='true'>
      <uri>model://OakD-Lite</uri>
      <pose>.12 .03 .242 0 0 0</pose>
    </include>
    <joint name="zed2_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to="base_link">.12 .03 .242 0 0 0</pose>
    </joint>
  </model>
</sdf>
